<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:button="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCommonBackground">

    <RelativeLayout
        android:id="@+id/rl1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/ll_hole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_hole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/text_hole_num"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/common_text_size" />

            <TextView
                android:id="@+id/tv_hole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/common_text_size" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@id/txt_row"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/txt_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:text="@string/text_row_num"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/txt_inside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="50dp"
            android:layout_toStartOf="@id/tv_inside"
            android:text="@string/text_inside_num"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/tv_inside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/common_text_size" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/rl2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/ll2"
        android:layout_below="@id/rl1"
        android:layout_centerVertical="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_tube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:text="@string/text_tube_num"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/middle_text_size" />

        <TextView
            android:id="@+id/tv_tube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="@color/colorPopupTitleText"
            android:textSize="@dimen/large_text_size" />

        <TextView
            android:id="@+id/txt_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:text="@string/text_current_delay"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/middle_text_size" />

        <TextView
            android:id="@+id/tv_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorPopupTitleText"
            android:textSize="@dimen/large_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl3"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="30dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:text="@string/register_line"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />

        <CheckBox
            android:id="@+id/cb_mode"
            style="@style/SettingsCheckBoxTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/scan_line"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rl3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl_set_delay"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_last_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="@string/text_last_delay"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/tv_last_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/common_text_size" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/rl_set_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/rl_open_air"
        android:layout_marginStart="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_row_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/text_row_delay"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/common_text_size" />

            <TextView
                android:id="@+id/tv_row_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/colorHighlightText"
                android:textSize="@dimen/common_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_hole_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_hole_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/text_hole_delay"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/common_text_size" />

            <TextView
                android:id="@+id/tv_hole_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/colorHighlightText"
                android:textSize="@dimen/common_text_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_inside_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/text_inside_delay"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/common_text_size"
                tools:ignore="RelativeOverlap" />

            <TextView
                android:id="@+id/tv_inside_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:background="@drawable/tv_clickable"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/colorHighlightText"
                android:textSize="@dimen/common_text_size" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:id="@+id/rl_open_air"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_gravity="center_vertical"
        android:columnCount="3"
        android:orientation="horizontal">

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_next_hole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_next_hole"
            android:textSize="@dimen/button_text_size"
            button:keyCode="1" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_next_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_next_row"
            android:textSize="@dimen/button_text_size"
            button:keyCode="2" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_inside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_hole_inside"
            android:textSize="@dimen/button_text_size"
            button:keyCode="3" />
    </GridLayout>
</RelativeLayout>
