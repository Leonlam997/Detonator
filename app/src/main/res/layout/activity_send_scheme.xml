<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCommonBackground"
    tools:context=".activity.SendSchemeActivity">

    <ListView
        android:id="@+id/lv_devices"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/gl_btn"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@color/colorTableLine"
        android:dividerHeight="1dp"
        android:fadingEdge="none"
        android:footerDividersEnabled="true"
        android:listSelector="@color/colorListSelector"
        android:scrollbars="vertical" />

    <GridLayout
        android:id="@+id/gl_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:columnCount="2"
        android:rowCount="1">

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/menu_send_list"
            android:textSize="@dimen/button_text_size"
            app:keyCode="1" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_scan_device"
            android:textSize="@dimen/button_text_size"
            app:keyCode="3" />
    </GridLayout>
</RelativeLayout>