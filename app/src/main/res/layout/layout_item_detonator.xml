<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/text_serial_no"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_serial_no"
        android:textColor="#000000"
        android:textSize="@dimen/table_text2_size" />

    <View
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@color/colorTableLine" />

    <TextView
        android:id="@+id/text_address"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:ellipsize="middle"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_address"
        android:textColor="#000000"
        android:textSize="@dimen/table_text_size" />

    <View
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@color/colorTableLine" />

    <TextView
        android:id="@+id/text_delay"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="1.8"
        android:gravity="center"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_delay"
        android:textColor="#000000"
        android:textSize="@dimen/table_text_size" />

    <View
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@color/colorTableLine" />

    <com.leon.detonator.component.MarqueeTextView
        android:id="@+id/text_row"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_row"
        android:textColor="#000000"
        android:textSize="@dimen/table_text2_size" />

    <View
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@color/colorTableLine" />

    <com.leon.detonator.component.MarqueeTextView
        android:id="@+id/text_hole"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_hole"
        android:textColor="#000000"
        android:textSize="@dimen/table_text2_size" />

    <View
        android:id="@+id/line_inside"
        android:layout_width="1dp"
        android:layout_height="fill_parent"
        android:background="@color/colorTableLine" />

    <com.leon.detonator.component.MarqueeTextView
        android:id="@+id/text_inside"
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_weight="0.6"
        android:ellipsize="marquee"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:text="@string/table_inside"
        android:textColor="#000000"
        android:textSize="@dimen/table_text2_size" />
</LinearLayout>
