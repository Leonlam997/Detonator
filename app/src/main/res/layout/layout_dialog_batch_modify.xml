<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/shape_list_item_bg">

        <CheckBox
            android:id="@+id/cb_selected_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp"
            android:text="@string/text_select_all"
            android:textSize="@dimen/label_text_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/cb_selected_all"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_from"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_from"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorLabelText"
                android:textColorHint="@color/colorHintText"
                android:textSize="@dimen/dialog_edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_to"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_to"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorLabelText"
                android:textColorHint="@color/colorHintText"
                android:textSize="@dimen/dialog_edit_text" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/shape_list_item_bg">

        <CheckBox
            android:id="@+id/cb_delay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/cb_delay_increase"
            android:layout_toEndOf="@id/cb_delay"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_delay"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_delay"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:hint="@string/delay_unit"
                android:maxLength="5"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/dialog_edit_text" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_delay_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="@string/delay_interval"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/shape_list_item_bg">

        <CheckBox
            android:id="@+id/cb_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/cb_row_increase"
            android:layout_toEndOf="@id/cb_row"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_row_num"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_row"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorLabelText"
                android:textColorHint="@color/colorHintText"
                android:textSize="@dimen/dialog_edit_text" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_row_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="@string/number_increase"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_hole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/shape_list_item_bg">

        <CheckBox
            android:id="@+id/cb_hole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/cb_hole_increase"
            android:layout_toEndOf="@id/cb_hole"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_hole_num"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_hole"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorLabelText"
                android:textColorHint="@color/colorHintText"
                android:textSize="@dimen/dialog_edit_text" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_hole_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="@string/number_increase"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/ll_inside"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:background="@drawable/shape_list_item_bg">

        <CheckBox
            android:id="@+id/cb_inside"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/cb_inside_increase"
            android:layout_toEndOf="@id/cb_inside"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_inside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_inside_num"
                android:textColor="@color/colorLabelText"
                android:textSize="@dimen/label_text_size" />

            <EditText
                android:id="@+id/et_inside"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="@color/colorLabelText"
                android:textColorHint="@color/colorHintText"
                android:textSize="@dimen/dialog_edit_text" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_inside_increase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:text="@string/number_increase"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/label_text_size" />
    </RelativeLayout>
</LinearLayout>