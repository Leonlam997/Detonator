<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:button="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCommonBackground">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/ll_info">

        <androidx.viewpager.widget.PagerTabStrip
            android:id="@+id/pager_tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:padding="0dp" />
    </androidx.viewpager.widget.ViewPager>

    <LinearLayout
        android:id="@+id/ll_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/gl_btn"
        android:layout_margin="2dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:background="@drawable/shape_list_item_bg"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_on_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/tv_off_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

        <TextView
            android:id="@+id/tv_unregister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/colorLabelText"
            android:textSize="@dimen/common_text_size" />

    </LinearLayout>

    <GridLayout
        android:id="@+id/gl_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:columnCount="2"
        android:orientation="horizontal">

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_rescan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_start_detect"
            android:textSize="@dimen/button_text_size"
            button:keyCode="1" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_charge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:text="@string/button_enter_charge"
            android:textSize="@dimen/button_text_size"
            button:keyCode="3" />
    </GridLayout>
</RelativeLayout>