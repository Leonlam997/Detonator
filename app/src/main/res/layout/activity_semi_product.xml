<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:button="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorCommonBackground">

    <LinearLayout
        android:id="@+id/ll_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="78dp"
            android:layout_marginTop="20dp"
            android:text="@string/select_type"
            android:textColor="@color/colorSemiProductCommonText"
            android:textSize="@dimen/common_text_size" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="277dp"
            android:layout_height="43dp"
            android:layout_marginTop="18dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_code_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ll_select"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="@string/code_text"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <TextView
        android:id="@+id/tv_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/tv_code_text"
        android:layout_alignEnd="@id/tv_code_text"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="5dp"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <TextView
        android:id="@+id/tv_voltage_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_code_text"
        android:layout_marginStart="43dp"
        android:layout_marginTop="22dp"
        android:text="@string/voltage_text"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <TextView
        android:id="@+id/tv_voltage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/tv_voltage_text"
        android:layout_alignEnd="@id/tv_voltage_text"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <TextView
        android:id="@+id/tv_current_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_code_text"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="43dp"
        android:text="@string/current_text"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <TextView
        android:id="@+id/tv_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/tv_current_text"
        android:layout_alignEnd="@id/tv_current_text"
        android:layout_marginEnd="45dp"
        android:layout_marginBottom="5dp"
        android:gravity="center"
        android:textColor="@color/colorSemiProductCommonText"
        android:textSize="@dimen/common_text_size" />

    <CheckBox
        android:id="@+id/cb_write"
        style="@style/NormalCheckBoxTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/gl_btn"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="10dp"
        android:checked="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/text_write_sn"
        android:textSize="@dimen/common_text_size" />

    <CheckBox
        android:id="@+id/cb_lock"
        style="@style/NormalCheckBoxTheme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/gl_btn"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="80dp"
        android:layout_marginBottom="10dp"
        android:checked="true"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/text_lock_detonator"
        android:textSize="@dimen/common_text_size" />

    <GridLayout
        android:id="@+id/gl_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="5dp"
        android:columnCount="3"
        android:orientation="horizontal">

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:padding="0dp"
            android:text="@string/button_self_test"
            android:textColor="@color/colorButtonEnabled"
            android:textSize="@dimen/button_text_size"
            button:bigButton="false"
            button:keyCode="1" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:padding="0dp"
            android:text="@string/button_scan"
            android:textColor="@color/colorButtonEnabled"
            android:textSize="@dimen/button_text_size"
            button:bigButton="false"
            button:keyCode="2" />

        <com.leon.detonator.component.MyButton
            android:id="@+id/btn_manual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_gravity="center"
            android:padding="0dp"
            android:text="@string/button_manual"
            android:textColor="@color/colorButtonEnabled"
            android:textSize="@dimen/button_text_size"
            button:bigButton="false"
            button:keyCode="3" />
    </GridLayout>
</RelativeLayout>